# Copy to .env.local for `pnpm dev`. !!! Never commit real secrets !!!

# Where is this running? { local | ci | staging | production }
# NOTE: `next build` always sets NODE_ENV=production, so use DEPLOY_ENV to tell environments apart.
DEPLOY_ENV=local

# Databases (src/db/databases.ts; infra/docker-compose.yml creates them)
# Each database is separate, with two roles:
#   <NAME>_DATABASE_URL  the running app, as <name>_app (read/write rows, no schema changes)
#   <NAME>_MIGRATE_URL   `pnpm db:migrate` only, as <name>_owner (never used by the app)
AUTH_DATABASE_URL=postgres://auth_app:auth_app_dev@localhost:5432/auth_db
AUTH_MIGRATE_URL=postgres://auth_owner:auth_owner_dev@localhost:5432/auth_db
SESSION_DATABASE_URL=postgres://session_app:session_app_dev@localhost:5432/session_db
SESSION_MIGRATE_URL=postgres://session_owner:session_owner_dev@localhost:5432/session_db
ENGAGEMENT_DATABASE_URL=postgres://engagement_app:engagement_app_dev@localhost:5432/engagement_db
ENGAGEMENT_MIGRATE_URL=postgres://engagement_owner:engagement_owner_dev@localhost:5432/engagement_db

# Mail (Mailpit in dev/CI: UI http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="ASE Assignment <no-reply@app.local>"
APP_BASE_URL=https://localhost:8443
