#!/usr/bin/env bash
# Blocks direct pushes to master/develop and pushes of badly named branches.

zero='0000000000000000000000000000000000000000'
status=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a branch is fine
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  branch="${remote_ref#refs/heads/}"

  case "$branch" in
    master|develop)
      echo "ERR: Don't push to '$branch' directly; open a pull request." >&2
      status=1 ;;
    feature/?*|bugfix/?*|hotfix/?*|release/?*) ;;
    *)
      echo "  Branch '$branch' doesn't follow the naming convention." >&2
      echo "  Use feature/<name>, bugfix/<name>, hotfix/<name> or release/<version>." >&2
      echo "  Rename with: git branch -m feature/<name>" >&2
      status=1 ;;
  esac
done

exit $status
